# macOS
.DS_Store

# BERT checkpoint weights: 438 MB, exceeds GitHub's 100 MB per-file limit.
# The rest of models/saved_bert_model/ (config.json, head_config.json, tokenizer.json,
# tokenizer_config.json) IS tracked — it is the label/sentiment contract.
# A fresh clone needs model.safetensors supplied out-of-band.
models/saved_bert_model/model.safetensors

# Derived pipeline intermediates — regenerated by:
#   python scripts/build_features.py       -> processed_reviews.csv
#   python scripts/bert_inference.py       -> bert_sub_comments.csv
data/processed/processed_reviews.csv
data/processed/bert_sub_comments.csv
data/processed/processing_temp.csv

# Terraform — generated state, saved plans, real variable files and the real
# backend configuration never belong in Git. The .example files are tracked.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
terraform.tfvars
backend.hcl

# Test artefacts
.pytest_cache/
