# The ReviewAssist frontend image: Streamlit on Railway.
#
# The frontend never loads BERT.  In the hosted environment BERT_INFERENCE_MODE
# is "remote" and the app calls the AWS API, so Torch and Transformers are
# absent from this image and the frontend stays small.
#
# The GoogleNews word2vec binary (about 1.53 GB) is NOT in the image either: it
# is gitignored and lives on a Railway Volume mounted at /app/models/trained_model,
# which is the path models/scoring.py already resolves.

FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    NLTK_DATA=/app/nltk_data

WORKDIR /app

COPY frontend-requirements.txt ./
RUN pip install --no-cache-dir -r frontend-requirements.txt

# The NLTK corpora the text cleaner needs.  Downloaded at build time so the
# running container never reaches the network for them.
RUN python -c "import nltk; nltk.download(['punkt', 'punkt_tab', 'wordnet', 'stopwords', 'omw-1.4'], download_dir='/app/nltk_data')"

COPY . .

EXPOSE 8501

# Railway supplies $PORT.
CMD ["sh", "-c", "streamlit run app.py --server.address 0.0.0.0 --server.port ${PORT:-8501}"]
