# Copy this file to `terraform.tfvars` and adjust it. `terraform.tfvars` is
# gitignored; only this example is tracked.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# Nothing secret belongs in this file. The API token and the LLM provider key
# are seeded into AWS Secrets Manager out of band, after the first apply.

region      = "us-east-1"
name_prefix = "reviewassist"

# An existing VPC with at least two public subnets in different Availability
# Zones. This stack does not create networking.
vpc_id           = "vpc-0123456789abcdef0"
public_subnet_ids = [
  "subnet-0123456789abcdef0",
  "subnet-0fedcba9876543210",
]

# The tag of the backend image in ECR. Push the image before raising
# desired_count above 0.
api_image_tag = "v1"

# The public HTTPS name the frontend calls, and its ACM certificate.
api_domain_name    = "api.reviewassist.example"
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# Which provider splits the reviews.
llm_provider = "openrouter"

# 0 for the first apply: the image does not exist in ECR until it is pushed.
desired_count = 0

tags = {
  Project = "reviewassist"
  Managed = "terraform"
}
